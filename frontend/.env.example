# Everything NEXT_PUBLIC_* is compiled into browser JavaScript and visible to every visitor.
# Never put secrets here (no API keys, no Razorpay key secret, no JWT secrets). Those live in the backend .env only.

# Base URL of the Tirvona API (the NestJS backend). The backend must list this site's origin in CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public site URL (canonical links / Open Graph).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional, development only. "true" pre-fills the seeded owner e-mail on the login form. It never signs anyone in,
# never fabricates tokens and never replaces API data. A production build/start FAILS if this is "true".
# NEXT_PUBLIC_DEMO_MODE=false

# ---- Server-side only (runtime, never NEXT_PUBLIC_, never a build argument) ----------------------------------------------
# Private address the web server uses to reach the API (server-side rendering and the /api/session sign-in proxy).
# Falls back to NEXT_PUBLIC_API_URL when unset. Example in Docker compose: http://api:3000
# API_INTERNAL_URL=

# Shared with the API (the same value as BFF_SHARED_SECRET in backend/.env), 32+ random characters (openssl rand -hex 32).
# The web server sends it with each sign-in so the API can trust the visitor address it forwards. Unset = every web login
# shares ONE rate limit (the web server's address) and audit logs show that address.
# BFF_SHARED_SECRET=
