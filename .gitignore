# dependencies
node_modules/

# build output
dist/
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# environment files: real values never go in Git. Only the *.example templates are tracked.
.env
.env.*
!.env.example

# credentials / private keys / certificates
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
*.tfvars
service-account*.json

# test artefacts
test-results/
playwright-report/
playwright/.cache/

# logs and OS/editor files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
