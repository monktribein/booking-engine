# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- PostgreSQL (Supabase)
# Supabase dashboard -> Connect (or Project Settings -> Database -> Connection string). Replace [YOUR-PASSWORD] with the
# database password. Which string to use:
#   * App (API + worker), serverless or many instances:  Transaction pooler, port 6543  (prepared statements are not used)
#   * App on one long-lived server / container:           Direct connection (db.<ref>.supabase.co:5432) or Session pooler
#   * Migrations (npm run db:migrate):                    Direct connection or Session pooler, NOT the transaction pooler
# Local PostgreSQL works too: postgresql://postgres:postgres@127.0.0.1:5432/tirvona  (SSL is off automatically for loopback)
# The password must be URL-encoded if it contains characters such as @ : / # ?
DATABASE_URL=
# disable | require | verify-full. Default: disable for localhost, require (encrypted, certificate not verified) otherwise.
# Production should use verify-full with Supabase's CA certificate (Dashboard -> Database -> SSL configuration).
# DATABASE_SSL=verify-full
# PEM text or a file path; needed for verify-full.
# DATABASE_CA_CERT=/etc/ssl/certs/supabase-ca.crt
# Connections per process. Keep (API instances + worker instances) x this below your Supabase plan's connection limit.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------- Redis / BullMQ
REDIS_URL=redis://localhost:6379
# bullmq (production) | inline (tests / Redis-less local dev only)
QUEUE_DRIVER=bullmq
# API-only instances: WORKERS_ENABLED=false, SCHEDULER_ENABLED=false (the worker process runs them)
WORKERS_ENABLED=true
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------- auth (generate: openssl rand -hex 48)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# ---------------------------------------------------------------- encryption of channel credentials / guest ID numbers
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production: inject from a secrets manager / KMS, never commit.
ENCRYPTION_KEY=

# ---------------------------------------------------------------- Razorpay (https://dashboard.razorpay.com → API keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# false = direct bookings are confirmed immediately (pay at property)
BOOKING_ENGINE_REQUIRE_PAYMENT=true

# ---------------------------------------------------------------- mock OTA (dev/test only; refused in production)
MOCK_CHANNEL_ENABLED=true
MOCK_CHANNEL_WEBHOOK_SECRET=change-me-dev-only
MOCK_CHANNEL_FAILURE_RATE=0

# ---------------------------------------------------------------- misc
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=5

# ---- Operations (see docs/OPERATIONS.md) ---------------------------------------------------------
# E-mail delivery for booking confirmations (any SMTP service). Unset = e-mails are only LOGGED (nothing is delivered).
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# SMTP_FROM="Radha Ashram <bookings@example.com>"

# Logging: JSON lines are the default in production; LOG_FORMAT=text for human-readable logs, LOG_LEVEL=debug for debug lines.
# LOG_FORMAT=json
# LOG_LEVEL=info

# Production only: confirming public bookings WITHOUT online payment must be an explicit decision.
# BOOKING_ENGINE_REQUIRE_PAYMENT=true
# ALLOW_PAY_AT_PROPERTY=true

# Redis key prefix of the queues (default "tirvona"). Use a distinct one if several environments share a Redis.
# QUEUE_PREFIX=tirvona

# ---- docker compose: frontend service (PUBLIC values, compiled into the browser bundle; never secrets) ----
# PUBLIC_API_URL=https://api.example.com
# PUBLIC_APP_URL=https://app.example.com
# Local production-mode run over plain http only:
# ALLOW_INSECURE_API_URL=true

# ---- Public API (docs/PUBLIC_API.md) ----------------------------------------------------------------
# Requests per window for each API key (shared across API instances through Redis).
# API_KEY_RATE_LIMIT=300
# API_KEY_RATE_TTL_MS=60000
# Outbound webhooks: per-request timeout. 12 attempts with exponential backoff (about 17 h) are made per delivery.
# WEBHOOK_TIMEOUT_MS=10000
# DEVELOPMENT ONLY: allow webhook URLs on http / loopback / private addresses (default on outside production).
# REFUSED in production (it would allow server-side request forgery).
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Logging of every HTTP request line (default true). Set false to silence request logs.
# LOG_REQUESTS=true

# ---- Partner onboarding ---------------------------------------------------------------------------------
# true (default): a newly registered organization is PENDING_APPROVAL until a platform admin approves it. Pending partners can set up
# their property privately, but cannot publish it, issue API keys, receive webhooks or ask for integrations.
# false: registration is self-service and organizations are active immediately.
# Platform admins are created with:  ADMIN_EMAIL=... ADMIN_NAME=... npm run admin:create:dev   (never through the API)
# PARTNER_APPROVAL_REQUIRED=true

# ---- Web app sessions (refresh token in an HttpOnly cookie) ----------------------------------------------
# The Next.js app signs users in through its own server so the refresh token never reaches browser JavaScript. That server forwards
# the visitor's real address to this API; it is trusted only when it also sends this shared secret. Set the SAME value (32+ random
# characters: openssl rand -hex 32) as BFF_SHARED_SECRET on the web app (server-side only, never NEXT_PUBLIC_). Unset = the address
# of the web server is used, which shares one login rate limit between all users.
# BFF_SHARED_SECRET=

# ---- Public API reference -----------------------------------------------------------------------------
# The versioned /v1 reference page (/docs/v1) and its OpenAPI JSON (/docs/v1/openapi.json) are served by default, also in production,
# because integrators need them. Set false to hide them. The internal API docs (/docs) are controlled by SWAGGER_ENABLED.
# PUBLIC_API_DOCS_ENABLED=true

# Configuration-driven channel providers (database-backed definitions + generic REST connector). Default off: only the built-in
# adapters are used. Turn on after migration 0003 has been applied. Private/loopback provider hosts follow WEBHOOK_ALLOW_PRIVATE_TARGETS.
# CHANNEL_PROVIDERS_ENABLED=false
